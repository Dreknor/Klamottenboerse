# Klamottenbörse V2 – Einstellungen für den Server
#
# Kopieren nach .env, dann die mit <…> markierten Werte eintragen und
# „php artisan key:generate“ ausführen. install.sh erledigt das automatisch.
# Die .env enthält Passwörter: nie ins Git-Repository hochladen!
#
# Für die Entwicklung am eigenen Rechner stattdessen: Umgebung „local“, Debug „true“,
# APP_URL http://localhost:8000, Log-Level „debug“, Datenbank „sqlite“ (ohne DB_HOST … DB_PASSWORD),
# Mailer „log“ und Secure-Cookie „false“.

# --- Anwendung ---------------------------------------------------------------

APP_NAME="Klamottenbörse"
APP_ENV=production
APP_KEY=
# Auf dem Server immer false – sonst sieht jeder technische Details samt Pfaden und Zugangsdaten
APP_DEBUG=false
# Adresse, unter der die Seite erreichbar ist (mit https://, ohne / am Ende)
APP_URL=https://<deine-domain.de>

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Protokolle --------------------------------------------------------------
# Warnungen und Fehler landen zusätzlich im Backend unter System → Fehlerprotokoll

LOG_CHANNEL=stack
LOG_STACK=single,datenbank
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Datenbank (MySQL/MariaDB, beim Hoster anlegen) --------------------------

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<datenbankname>
DB_USERNAME=<benutzer>
DB_PASSWORD=<passwort>

# --- Sitzungen, Cache, Warteschlange (alles in der Datenbank, kein Redis nötig) ---

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=klamottenboerse_session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Anmelde-Cookie nur über https – bei einer Seite ohne https auf false setzen
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mailversand (SMTP-Zugang des Mail-Kontos) -------------------------------
# Port 465 → MAIL_SCHEME=smtps, Port 587 → MAIL_SCHEME=smtp
# Testen: Backend → System → „Testmail senden“ oder „php artisan mail:test adresse@example.org“
# Achtung: Mailer „log“ verschickt nichts (nur zum Entwickeln)

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<mail.deine-domain.de>
MAIL_PORT=465
MAIL_USERNAME=<postfach@deine-domain.de>
MAIL_PASSWORD=<passwort>
# Muss zum Mail-Konto gehören, sonst lehnen viele Server die Mails ab
MAIL_FROM_ADDRESS="<postfach@deine-domain.de>"
MAIL_FROM_NAME="${APP_NAME}"

# --- Postfach für den Posteingang im Backend (IMAP) --------------------------
# Leer lassen, wenn der Posteingang nicht genutzt wird. Lokal mit Mailpit: IMAP_TREIBER=mailpit

IMAP_TREIBER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
# Ordnernamen beim Hoster, falls abweichend (z. B. INBOX.Spam)
# IMAP_ORDNER_SPAM=Junk
# IMAP_ORDNER_PAPIERKORB=Trash

# --- Alte Datenbank (V1), nur für den einmaligen Import: php artisan v1:import ---

V1_DB_HOST=localhost
V1_DB_PORT=3306
V1_DB_DATABASE=
V1_DB_USERNAME=
V1_DB_PASSWORD=

# --- Updates aus dem Backend (System) ----------------------------------------
# Auf manchen Hostern z. B. UPDATE_PHP=php84 oder UPDATE_COMPOSER="php composer.phar"

UPDATE_PHP=php
UPDATE_COMPOSER=composer
UPDATE_BRANCH=v2

# --- Demo-Installation (nur für eine eigene Spielwiese, nie für die echte Seite!) ---
# DEMO_MODUS=true

VITE_APP_NAME="${APP_NAME}"
